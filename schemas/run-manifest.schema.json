{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ciw.tfwelch.com/schemas/run-manifest.schema.json",
  "title": "Cycling Investment Workbench run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "project_id",
    "status",
    "created_at",
    "updated_at",
    "config",
    "model",
    "seeds",
    "sources",
    "runtime",
    "stages"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{7,63}$"},
    "project_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["pending", "running", "succeeded", "failed"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_path", "snapshot_path", "sha256"],
      "properties": {
        "source_path": {"type": "string"},
        "snapshot_path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_version",
        "methodology_version",
        "implementation_sha256",
        "configuration_schema_version",
        "run_manifest_schema_version"
      ],
      "properties": {
        "package_version": {"type": "string", "minLength": 1},
        "methodology_version": {"type": "string", "minLength": 1},
        "implementation_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "configuration_schema_version": {"type": "integer", "minimum": 1},
        "run_manifest_schema_version": {"type": "integer", "minimum": 1}
      }
    },
    "seeds": {
      "type": "object",
      "additionalProperties": {"type": "integer"}
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "required", "status", "size", "sha256"],
        "properties": {
          "path": {"type": "string"},
          "required": {"type": "boolean"},
          "status": {"enum": ["available", "missing", "mismatch"]},
          "size": {"type": ["integer", "null"], "minimum": 0},
          "sha256": {
            "oneOf": [
              {"type": "null"},
              {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            ]
          }
        }
      }
    },
    "runtime": {"type": "object"},
    "stages": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/stage"}
    }
  },
  "$defs": {
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "version",
        "fingerprint",
        "started_at",
        "completed_at",
        "duration_seconds",
        "outputs",
        "metrics",
        "error"
      ],
      "properties": {
        "status": {"enum": ["pending", "running", "succeeded", "failed", "skipped", "cached"]},
        "version": {"type": "string"},
        "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "started_at": {"type": ["string", "null"], "format": "date-time"},
        "completed_at": {"type": ["string", "null"], "format": "date-time"},
        "duration_seconds": {"type": ["number", "null"], "minimum": 0},
        "outputs": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "size", "sha256"],
            "properties": {
              "path": {"type": "string"},
              "size": {"type": "integer", "minimum": 0},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        },
        "metrics": {"type": "object"},
        "error": {"type": ["string", "null"]}
      }
    }
  }
}
