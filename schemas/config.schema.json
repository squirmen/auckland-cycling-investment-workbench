{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ciw.tfwelch.com/schemas/config.schema.json",
  "title": "Cycling Investment Workbench project configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "paths", "sources", "pipeline", "export", "parameters"],
  "properties": {
    "schema_version": {"const": 1},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "region", "crs", "timezone"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]+$"},
        "title": {"type": "string", "minLength": 1},
        "region": {"type": "string", "minLength": 1},
        "crs": {"type": "string", "pattern": "^EPSG:[0-9]+$"},
        "timezone": {"type": "string", "minLength": 1}
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "cache", "runs", "exports", "web_source"],
      "properties": {
        "data": {"$ref": "#/$defs/relativePath"},
        "cache": {"$ref": "#/$defs/relativePath"},
        "runs": {"$ref": "#/$defs/relativePath"},
        "exports": {"$ref": "#/$defs/relativePath"},
        "web_source": {"$ref": "#/$defs/relativePath"}
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "source-registry.schema.json#/$defs/source"
      }
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resume", "stages"],
      "properties": {
        "resume": {"type": "boolean"},
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version", "depends_on", "options"],
            "properties": {
              "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
              "version": {"type": "string", "minLength": 1},
              "depends_on": {
                "type": "array",
                "uniqueItems": true,
                "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}
              },
              "options": {"type": "object"}
            }
          }
        }
      }
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_data_dir", "manifest_filename", "layer_filenames"],
      "properties": {
        "public_data_dir": {"$ref": "#/$defs/relativePath"},
        "manifest_filename": {"type": "string", "pattern": "^[^/\\\\]+\\.json$"},
        "layer_filenames": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cells", "network", "candidates", "programmes", "counters"],
          "properties": {
            "cells": {"type": "string", "pattern": "^[^/\\\\]+\\.geojson$"},
            "network": {"type": "string", "pattern": "^[^/\\\\]+\\.geojson$"},
            "candidates": {"type": "string", "pattern": "^[^/\\\\]+\\.geojson$"},
            "programmes": {"type": "string", "pattern": "^[^/\\\\]+\\.geojson$"},
            "counters": {"type": "string", "pattern": "^[^/\\\\]+\\.geojson$"}
          }
        }
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/jsonValue"}
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "jsonValue": {
      "oneOf": [
        {"type": "null"},
        {"type": "boolean"},
        {"type": "number"},
        {"type": "string"},
        {"type": "array", "items": {"$ref": "#/$defs/jsonValue"}},
        {"type": "object", "additionalProperties": {"$ref": "#/$defs/jsonValue"}}
      ]
    }
  }
}
