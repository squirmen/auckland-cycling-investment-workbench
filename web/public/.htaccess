# SPAN static site (span.tfwelch.com). Ignored by hosts that are not Apache.

Options -Indexes
DirectoryIndex index.html

AddType application/geo+json .geojson
AddType text/markdown .md
# The method notes are UTF-8; without a charset browsers show dashes and symbols garbled.
AddCharset utf-8 .md

# The data files are large JSON and shrink about tenfold when compressed. Scripts are
# listed under both names: this host sends them as text/javascript.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/markdown text/javascript application/javascript application/json application/geo+json image/svg+xml
</IfModule>

# Plain HTTP gets the HTTPS address: the browser checks data hashes with Web Crypto, which
# works only on HTTPS, so over HTTP the page would load and then show no data. Only the live
# host is redirected, so a local or preview copy served over HTTP still works; certificate
# checks under .well-known are left alone.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP_HOST} ^span\.tfwelch\.com$ [NC]
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule ^ https://span.tfwelch.com%{REQUEST_URI} [R=301,L]
</IfModule>

# The release archive also carries a brotli copy (name.br) of each large script,
# style and data file, made once when the site is packaged. A browser that accepts
# brotli gets that copy; it is smaller than the gzip made above and costs the
# server nothing. Anything without a .br copy is compressed on request as before.
<IfModule mod_rewrite.c>
  <IfModule mod_headers.c>
    RewriteEngine On
    RewriteCond %{HTTP:Accept-Encoding} \bbr\b
    RewriteCond %{REQUEST_FILENAME}.br -f
    RewriteRule ^(.+)\.(css|js|json|geojson)$ $1.$2.br [L]

    # Keep the original type and stop the copy being compressed a second time.
    RewriteRule \.css\.br$ - [T=text/css,E=no-gzip:1]
    RewriteRule \.js\.br$ - [T=application/javascript,E=no-gzip:1]
    RewriteRule \.json\.br$ - [T=application/json,E=no-gzip:1]
    RewriteRule \.geojson\.br$ - [T=application/geo+json,E=no-gzip:1]
    <FilesMatch "\.(css|js|json|geojson)\.br$">
      Header set Content-Encoding br
      Header append Vary Accept-Encoding
    </FilesMatch>
  </IfModule>
</IfModule>

# Script and style names carry a content hash, so they can be cached for a long
# time. The page may be reused for 5 minutes and the data for an hour; SPAN's own
# data requests revalidate on every visit, and each file is checked against the
# manifest's SHA-256 before use.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 week"
  ExpiresByType text/html "access plus 5 minutes"
  ExpiresByType application/json "access plus 1 hour"
  ExpiresByType application/geo+json "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
