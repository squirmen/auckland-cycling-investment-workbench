# SPAN static site (span.tfwelch.com). Ignored by hosts that are not Apache.

Options -Indexes
DirectoryIndex index.html

AddType application/geo+json .geojson
AddType text/markdown .md

# The data files are large JSON and shrink about tenfold when compressed.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/markdown application/javascript application/json application/geo+json image/svg+xml
</IfModule>

# The release archive also carries a brotli copy (name.br) of each large script,
# style and data file, made once when the site is packaged. A browser that accepts
# brotli gets that copy; it is smaller than the gzip made above and costs the
# server nothing. Anything without a .br copy is compressed on request as before.
<IfModule mod_rewrite.c>
  <IfModule mod_headers.c>
    RewriteEngine On
    RewriteCond %{HTTP:Accept-Encoding} \bbr\b
    RewriteCond %{REQUEST_FILENAME}.br -f
    RewriteRule ^(.+)\.(css|js|json|geojson)$ $1.$2.br [L]

    # Keep the original type and stop the copy being compressed a second time.
    RewriteRule \.css\.br$ - [T=text/css,E=no-gzip:1]
    RewriteRule \.js\.br$ - [T=application/javascript,E=no-gzip:1]
    RewriteRule \.json\.br$ - [T=application/json,E=no-gzip:1]
    RewriteRule \.geojson\.br$ - [T=application/geo+json,E=no-gzip:1]
    <FilesMatch "\.(css|js|json|geojson)\.br$">
      Header set Content-Encoding br
      Header append Vary Accept-Encoding
    </FilesMatch>
  </IfModule>
</IfModule>

# Script and style names carry a content hash, so they can be cached for a long
# time. The page and the data are checked on each visit.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 week"
  ExpiresByType text/html "access plus 5 minutes"
  ExpiresByType application/json "access plus 1 hour"
  ExpiresByType application/geo+json "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
