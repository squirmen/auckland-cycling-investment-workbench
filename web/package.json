{
  "name": "auckland-cycling-investment-workbench-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "24.19.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "capture:screenshots": "node scripts/capture-release-screenshots.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@axe-core/playwright": "4.10.2",
    "@types/leaflet": "1.9.20",
    "@types/node": "24.3.0",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.34.0",
    "globals": "16.3.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.41.0",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents": false
  }
}
